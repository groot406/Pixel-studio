# Pixel Studio Cloud — copy to .env (never commit it) or set these in your host's secret store.
NODE_ENV=production
PUBLIC_URL=https://app.pixelstudio.example
PORT=8080
DATABASE_PATH=/data/pixel-studio.db
# Set when running behind a reverse proxy / load balancer that sets X-Forwarded-For.
TRUST_PROXY=1

# AI (server-side keys; users never see them)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Sign-in email (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Pixel Studio <login@pixelstudio.example>
SUPPORT_EMAIL=support@pixelstudio.example

# Encrypts users' own OpenAI/Gemini keys at rest. Required in production for "bring your own AI"; keep it stable
# (changing it makes saved keys unreadable). Generate one with: openssl rand -base64 32
AI_KEY_SECRET=

# Billing (https://dashboard.stripe.com → Developers → API keys). `npm run cloud:stripe` creates the products and
# prices (and, with an https PUBLIC_URL, the webhook) and prints the values below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_CREDITS_1000=
# Stripe Managed Payments: Stripe is the merchant of record (tax, fraud, disputes). Set to 0 to sell as yourself.
STRIPE_MANAGED_PAYMENTS=1

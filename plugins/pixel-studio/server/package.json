{
  "name": "pixel-studio-32",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "A pixel-art animation editor with personal local Codex editing",
  "bin": {
    "pixelstudio": "local/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node local/start.mjs --open",
    "dev": "node --watch local/start.mjs --dev",
    "cloud": "node cloud/start.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs && npm test && npm run build",
    "benchmark": "node scripts/benchmark-pxa.mjs",
    "bench": "node --expose-gc scripts/bench.mjs",
    "formats": "node scripts/sync-format-guides.mjs",
    "mcp": "node local/cli.mjs mcp",
    "skills": "node local/cli.mjs skills install",
    "plugin": "node scripts/build-plugin.mjs",
    "plugin:install": "node local/cli.mjs plugin install"
  }
}
